# Target
TARGET_REPO="Nicolas25vlad/projeto-android-marvel"
BASE_BRANCH="main"

# Model
MODEL="gpt-6-luna"

# Schedule boundaries in the machine's local timezone.
# systemd starts the runner at 23:30 by default.
DISCOVERY_STOP="06:15"
WRAP_START="06:30"
HARD_STOP="07:00"

# Queue behavior
QUEUE_LABEL="nightly"
MAX_ISSUES_PER_NIGHT="4"
MAX_DISCOVERY_ISSUES="5"
AUTO_QUEUE_DISCOVERIES="false"

# Validation command executed by the runner after an implementation turn.
VALIDATE_CMD="./gradlew test lint assembleDebug"

# Codex permissions.
CODEX_SANDBOX="workspace-write"
CODEX_APPROVAL_POLICY="never"

# Dedicated storage. Do not point WORK_ROOT at your normal checkout.
WORK_ROOT="$HOME/.local/share/codex-automation"
STATE_ROOT="$HOME/.local/state/codex-automation"

# Optional extra project instructions appended to the nightly prompt.
EXTRA_INSTRUCTIONS=""

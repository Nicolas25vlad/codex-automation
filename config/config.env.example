# Target
TARGET_REPO="Nicolas25vlad/projeto-android-marvel"
BASE_BRANCH="main"

# Model
MODEL="gpt-6-luna"

# Schedule boundaries in the machine's local timezone.
# The bundled systemd timer starts the runner at 23:30.
DISCOVERY_STOP="06:15"
WRAP_START="06:30"
HARD_STOP="07:00"

# Queue behavior
QUEUE_LABEL="nightly"
MAX_ISSUES_PER_NIGHT="4"
MAX_DISCOVERY_ISSUES="5"

# Safe discoveries (bug/quality/ux) are queued for a future nightly run.
# "idea" findings are never auto-queued.
AUTO_QUEUE_DISCOVERIES="true"

# Validation executed outside the Codex sandbox after an implementation turn.
VALIDATE_CMD="./gradlew test lint assembleDebug"
MAX_VALIDATION_SECONDS="1800"

# Bound network operations so a broken connection cannot hold the runner forever.
GH_TIMEOUT_SECONDS="45"
GIT_TIMEOUT_SECONDS="180"

# Codex permissions. "never" means the unattended agent will not stop for approval;
# operations outside the sandbox simply remain unavailable.
CODEX_SANDBOX="workspace-write"
CODEX_APPROVAL_POLICY="never"

# Dedicated storage. Do not point WORK_ROOT at your normal human checkout.
WORK_ROOT="$HOME/.local/share/codex-automation"
STATE_ROOT="$HOME/.local/state/codex-automation"

# Identity used only for commits created by the nightly runner.
GIT_AUTHOR_NAME="Codex Nightly"
GIT_AUTHOR_EMAIL="codex-nightly@users.noreply.github.com"

# Optional project-specific instructions appended to every implementation prompt.
EXTRA_INSTRUCTIONS=""

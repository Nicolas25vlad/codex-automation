#!/usr/bin/env bash
set -Eeuo pipefail

MODE="normal"
case "${1:-}" in
  "") ;;
  --once) MODE="once" ;;
  --discover-only) MODE="discover-only" ;;
  --doctor) exec "${HOME}/.local/bin/codex-doctor" ;;
  --help|-h)
    cat <<'EOF'
Usage: codex-nightly [--once|--discover-only|--doctor]

  --once           process at most one queued issue, then wrap up
  --discover-only  skip implementation and run one bounded discovery pass
  --doctor         run environment/config preflight checks
EOF
    exit 0
    ;;
  *)
    echo "Unknown option: $1" >&2
    exit 2
    ;;
esac

CFG="${CODEX_AUTOMATION_CONFIG:-$HOME/.config/codex-automation/config.env}"
[[ -f "$CFG" ]] || { echo "Config not found: $CFG" >&2; exit 2; }
# shellcheck disable=SC1090
source "$CFG"

: "${TARGET_REPO:?TARGET_REPO is required}"
: "${BASE_BRANCH:=main}"
: "${MODEL:=gpt-6-luna}"
: "${DISCOVERY_STOP:=06:15}"
: "${WRAP_START:=06:30}"
: "${HARD_STOP:=07:00}"
: "${QUEUE_LABEL:=nightly}"
: "${MAX_ISSUES_PER_NIGHT:=4}"
: "${MAX_DISCOVERY_ISSUES:=5}"
: "${AUTO_QUEUE_DISCOVERIES:=true}"
: "${VALIDATE_CMD:=true}"
: "${MAX_VALIDATION_SECONDS:=1800}"
: "${GH_TIMEOUT_SECONDS:=45}"
: "${GIT_TIMEOUT_SECONDS:=180}"
: "${CODEX_SANDBOX:=workspace-write}"
: "${CODEX_APPROVAL_POLICY:=never}"
: "${WORK_ROOT:=$HOME/.local/share/codex-automation}"
: "${STATE_ROOT:=$HOME/.local/state/codex-automation}"
: "${GIT_AUTHOR_NAME:=Codex Nightly}"
: "${GIT_AUTHOR_EMAIL:=codex-nightly@users.noreply.github.com}"
: "${EXTRA_INSTRUCTIONS:=}"

required=(git gh codex jq timeout flock date)
for cmd in "${required[@]}"; do
  command -v "$cmd" >/dev/null 2>&1 || { echo "Missing command: $cmd" >&2; exit 2; }
done

[[ "$TARGET_REPO" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || {
  echo "TARGET_REPO must use owner/repo format" >&2
  exit 2
}

for n in MAX_ISSUES_PER_NIGHT MAX_DISCOVERY_ISSUES MAX_VALIDATION_SECONDS GH_TIMEOUT_SECONDS GIT_TIMEOUT_SECONDS; do
  value="${!n}"
  [[ "$value" =~ ^[0-9]+$ ]] && (( value > 0 )) || {
    echo "$n must be a positive integer" >&2
    exit 2
  }
done

gh auth status >/dev/null 2>&1 || { echo "gh is not authenticated" >&2; exit 2; }
codex login status >/dev/null 2>&1 || { echo "codex is not authenticated" >&2; exit 2; }

repo_dir="$WORK_ROOT/repos/$TARGET_REPO"
mkdir -p "$(dirname "$repo_dir")" "$STATE_ROOT"

exec 9>"$STATE_ROOT/runner.lock"
if ! flock -n 9; then
  echo "Another codex-nightly process already holds $STATE_ROOT/runner.lock" >&2
  exit 75
fi

now_epoch="$(date +%s)"
today_hard="$(date -d "today $HARD_STOP" +%s)"
if (( now_epoch >= today_hard )); then
  hard_epoch="$(date -d "tomorrow $HARD_STOP" +%s)"
  discovery_epoch="$(date -d "tomorrow $DISCOVERY_STOP" +%s)"
  wrap_epoch="$(date -d "tomorrow $WRAP_START" +%s)"
else
  hard_epoch="$today_hard"
  discovery_epoch="$(date -d "today $DISCOVERY_STOP" +%s)"
  wrap_epoch="$(date -d "today $WRAP_START" +%s)"
fi

if (( discovery_epoch >= wrap_epoch || wrap_epoch >= hard_epoch )); then
  echo "Invalid schedule: expected DISCOVERY_STOP < WRAP_START < HARD_STOP" >&2
  exit 2
fi

night_date="$(date -d "@$hard_epoch" +%F)"
run_id="$(date +%Y%m%dT%H%M%S)-$$"
run_tag="$(date +%H%M%S)"
run_dir="$STATE_ROOT/runs/$run_id"
mkdir -p "$run_dir"
ln -sfn "$run_dir" "$STATE_ROOT/latest"

run_log="$run_dir/run.log"
report="$run_dir/NIGHTLY_REPORT.md"
summary="$run_dir/summary.json"
processed="$run_dir/processed.txt"
prs_file="$run_dir/prs.tsv"
discoveries_file="$run_dir/discoveries.tsv"
blocked_file="$run_dir/blocked.tsv"
touch "$processed" "$prs_file" "$discoveries_file" "$blocked_file"

exec > >(tee -a "$run_log") 2>&1

log() { printf '[%s] %s\n' "$(date --iso-8601=seconds)" "$*"; }
remaining() { echo $((hard_epoch - $(date +%s))); }
before() { (( $(date +%s) < $1 )); }

bounded_seconds() {
  local cap="$1" left
  left="$(remaining)"
  (( left > 0 )) || return 1
  if (( left < cap )); then echo "$left"; else echo "$cap"; fi
}

hard_guard() {
  if ! before "$hard_epoch"; then
    log "hard stop reached"
    exit 124
  fi
}

set_phase() {
  local phase="$1"
  jq -n     --arg run_id "$run_id"     --arg phase "$phase"     --arg repo "$TARGET_REPO"     --arg model "$MODEL"     --arg now "$(date --iso-8601=seconds)"     '{run_id:$run_id,phase:$phase,repository:$repo,model:$model,updated_at:$now}'     > "$run_dir/state.json.tmp"
  mv "$run_dir/state.json.tmp" "$run_dir/state.json"
}

gh_read() {
  local secs attempt
  secs="$(bounded_seconds "$GH_TIMEOUT_SECONDS")" || return 124
  for attempt in 1 2 3; do
    if timeout --signal=TERM "${secs}s" gh "$@"; then
      return 0
    fi
    (( attempt < 3 )) || break
    sleep "$((attempt * 2))"
    secs="$(bounded_seconds "$GH_TIMEOUT_SECONDS")" || return 124
  done
  return 1
}

gh_write() {
  local secs
  secs="$(bounded_seconds "$GH_TIMEOUT_SECONDS")" || return 124
  timeout --signal=TERM "${secs}s" gh "$@"
}

git_net() {
  local secs attempt
  secs="$(bounded_seconds "$GIT_TIMEOUT_SECONDS")" || return 124
  for attempt in 1 2 3; do
    if timeout --signal=TERM "${secs}s" git "$@"; then
      return 0
    fi
    (( attempt < 3 )) || break
    sleep "$((attempt * 2))"
    secs="$(bounded_seconds "$GIT_TIMEOUT_SECONDS")" || return 124
  done
  return 1
}

cleanup() {
  set +e
  jobs -pr | xargs -r kill -TERM 2>/dev/null || true
  log "runner exiting"
}
trap cleanup EXIT INT TERM

log "run_id=$run_id night=$night_date repo=$TARGET_REPO model=$MODEL hard_stop=$(date -d "@$hard_epoch" --iso-8601=seconds)"
set_phase "preflight"

if [[ ! -d "$repo_dir/.git" ]]; then
  log "cloning $TARGET_REPO"
  gh_read repo clone "$TARGET_REPO" "$repo_dir"
  touch "$repo_dir/.git/codex-automation-managed"
fi

cd "$repo_dir"

managed_marker=".git/codex-automation-managed"
if [[ ! -f "$managed_marker" ]]; then
  if [[ -z "$(git status --porcelain)" ]]; then
    log "adopting clean legacy automation checkout"
    touch "$managed_marker"
  else
    log "workspace is dirty and not marked as automation-managed; refusing to modify it"
    exit 3
  fi
fi

mkdir -p .git/info
grep -qxF ".codex-automation/" .git/info/exclude 2>/dev/null || echo ".codex-automation/" >> .git/info/exclude
rm -rf .codex-automation

recovered_stash=""
if [[ -n "$(git status --porcelain)" ]]; then
  log "recovering interrupted managed workspace into git stash"
  git stash push -u -m "codex-automation recovery $run_id"
  recovered_stash="$(git stash list -1 --format='%gd %s')"
  printf '%s\n' "$recovered_stash" > "$run_dir/recovered-stash.txt"
fi

git_net fetch --prune origin
git checkout "$BASE_BRANCH"
git reset --hard "origin/$BASE_BRANCH"
hard_guard

cp "$HOME/.local/share/codex-automation/nightly.md" "$run_dir/nightly-prompt.md"

ensure_label() {
  gh_write label create "$1" --repo "$TARGET_REPO" --color "$2" --description "$3" 2>/dev/null || true
}
ensure_label "$QUEUE_LABEL" "6e7781" "Eligible for the nightly coding agent"
ensure_label "nightly:pr-open" "1f883d" "Nightly agent opened a draft PR"
ensure_label "nightly:blocked" "d1242f" "Nightly agent could not finish safely"
ensure_label "nightly:discovered" "8250df" "Found automatically during nightly discovery"
ensure_label "kind:bug" "d1242f" "Bug found by automation"
ensure_label "kind:quality" "bf8700" "Quality or test improvement"
ensure_label "kind:ux" "0969da" "User experience improvement"
ensure_label "kind:idea" "6e7781" "Idea requiring human review"

implemented=0
blocked=0
created_issues=0
github_errors=0

render_prompt() {
  local issue_json="$1"
  local template="$HOME/.local/share/codex-automation/nightly.md"
  [[ -f "$template" ]] || { echo "Nightly prompt not installed: $template" >&2; return 2; }
  local body
  body="$(cat "$template")"
  body="${body//\{\{ISSUE\}\}/$issue_json}"
  printf '%s\n\nAdditional local instructions:\n%s\n' "$body" "$EXTRA_INSTRUCTIONS"
}

run_codex() {
  local prompt="$1" name="$2" secs
  secs="$(remaining)"
  (( secs > 0 )) || return 124

  timeout --signal=TERM --kill-after=120s "${secs}s"     codex exec       --json       --sandbox "$CODEX_SANDBOX"       --ask-for-approval "$CODEX_APPROVAL_POLICY"       -m "$MODEL"       "$prompt"       > >(tee -a "$run_dir/codex-$name.jsonl")       2> >(tee -a "$run_dir/codex-$name.stderr.log" >&2)
}

run_validation() {
  local secs
  secs="$(bounded_seconds "$MAX_VALIDATION_SECONDS")" || return 124
  timeout --signal=TERM --kill-after=120s "${secs}s" bash -lc "$VALIDATE_CMD"
}

mark_blocked() {
  local num="$1" reason="$2"
  blocked=$((blocked + 1))
  printf '#%s\t%s\n' "$num" "$reason" >> "$blocked_file"
  gh_write issue edit "$num" --repo "$TARGET_REPO" --remove-label "$QUEUE_LABEL" --add-label "nightly:blocked" >/dev/null 2>&1 || {
    github_errors=$((github_errors + 1))
    log "warning: could not mark issue #$num blocked on GitHub"
  }
}

create_discovery_issues() {
  local file="$1" source="$2"
  [[ -f "$file" ]] || return 0
  jq -e '.items | type == "array"' "$file" >/dev/null 2>&1 || {
    log "warning: invalid discovery JSON in $file"
    return 0
  }

  while IFS= read -r item; do
    (( created_issues >= MAX_DISCOVERY_ISSUES )) && break
    hard_guard

    local type title summary_text evidence acceptance labels issue_url
    type="$(jq -r '.type // "quality"' <<<"$item")"
    case "$type" in
      bug|quality|ux|idea) ;;
      *) type="quality" ;;
    esac

    title="$(jq -r '.title // ""' <<<"$item")"
    summary_text="$(jq -r '.summary // ""' <<<"$item")"
    evidence="$(jq -r '.evidence // ""' <<<"$item")"
    acceptance="$(jq -r '.suggested_acceptance // ""' <<<"$item")"

    [[ -n "$title" ]] || continue

    if gh_read issue list --repo "$TARGET_REPO" --state all --search "$title" --limit 10 --json title --jq '.[].title' |
      grep -Fqi "$title"; then
      log "discovery duplicate skipped: $title"
      continue
    fi

    labels="nightly:discovered,kind:$type"
    if [[ "$AUTO_QUEUE_DISCOVERIES" == "true" && "$type" != "idea" ]]; then
      labels="$labels,$QUEUE_LABEL"
    fi

    if issue_url="$(gh_write issue create       --repo "$TARGET_REPO"       --title "[$type] $title"       --label "$labels"       --body "Discovered by codex-automation during the $night_date nightly run.

Source: $source

## Summary
$summary_text

## Evidence
$evidence

## Suggested acceptance criteria
$acceptance")"; then
      created_issues=$((created_issues + 1))
      printf '%s\t%s\t%s\n' "$type" "$title" "$issue_url" >> "$discoveries_file"
      log "created discovery issue: $issue_url"
    else
      github_errors=$((github_errors + 1))
      log "warning: failed to create discovery issue: $title"
    fi
  done < <(jq -c '.items[]' "$file")
}

publish_issue_work() {
  local num="$1" title="$2"
  local branch_name="nightly/$night_date/issue-$num-$run_tag"
  local issue_json prompt pr_url

  hard_guard
  set_phase "implementing-issue-$num"

  git checkout "$BASE_BRANCH"
  git reset --hard "origin/$BASE_BRANCH"
  git branch -D "$branch_name" 2>/dev/null || true
  git checkout -b "$branch_name"

  mkdir -p .codex-automation
  printf '{"items":[]}\n' > .codex-automation/discoveries.json

  if ! issue_json="$(gh_read issue view "$num" --repo "$TARGET_REPO" --json number,title,body,labels,url)"; then
    log "failed to read issue #$num"
    mark_blocked "$num" "GitHub issue read failed"
    git checkout "$BASE_BRANCH"
    git branch -D "$branch_name" 2>/dev/null || true
    return
  fi
  prompt="$(render_prompt "$issue_json")"

  log "issue #$num: $title"
  if ! run_codex "$prompt" "issue-$num"; then
    if ! before "$hard_epoch"; then exit 124; fi
    log "codex failed or stopped on issue #$num"
    mark_blocked "$num" "Codex execution failed or timed out"
    git reset --hard
    rm -rf .codex-automation
    git checkout "$BASE_BRANCH"
    git branch -D "$branch_name" 2>/dev/null || true
    return
  fi

  hard_guard

  project_changes="$(git status --porcelain | grep -v '^?? .codex-automation/' || true)"
  if [[ -z "$project_changes" ]]; then
    log "issue #$num produced no project changes"
    create_discovery_issues ".codex-automation/discoveries.json" "implementation attempt for #$num"
    mark_blocked "$num" "No project changes produced"
    rm -rf .codex-automation
    git checkout "$BASE_BRANCH"
    git branch -D "$branch_name" 2>/dev/null || true
    return
  fi

  set_phase "validating-issue-$num"
  log "validating issue #$num with: $VALIDATE_CMD"
  if ! run_validation; then
    if ! before "$hard_epoch"; then exit 124; fi
    log "validation failed for issue #$num"
    git diff --binary > "$run_dir/issue-$num-failed.patch" || true
    mark_blocked "$num" "Validation failed: $VALIDATE_CMD"
    git reset --hard
    rm -rf .codex-automation
    git checkout "$BASE_BRANCH"
    git branch -D "$branch_name" 2>/dev/null || true
    return
  fi

  hard_guard
  create_discovery_issues ".codex-automation/discoveries.json" "implementation of #$num"
  rm -rf .codex-automation

  git add -A
  git -c user.name="$GIT_AUTHOR_NAME" -c user.email="$GIT_AUTHOR_EMAIL"     commit -m "nightly: implement #$num"

  set_phase "publishing-issue-$num"
  if ! git_net push -u origin "$branch_name"; then
    log "push failed for issue #$num"
    mark_blocked "$num" "Git push failed; local commit preserved on $branch_name"
    return
  fi

  hard_guard
  if ! pr_url="$(gh_write pr create     --repo "$TARGET_REPO"     --base "$BASE_BRANCH"     --head "$branch_name"     --draft     --title "nightly: #$num $title"     --body "Automated overnight implementation for #$num.

Run: `$run_id`

Validation:
```
$VALIDATE_CMD
```

This PR is intentionally draft and was not merged automatically.")"; then
    github_errors=$((github_errors + 1))
    log "draft PR creation failed for issue #$num; remote branch preserved: $branch_name"
    mark_blocked "$num" "Draft PR creation failed; remote branch: $branch_name"
    return
  fi

  gh_write issue comment "$num" --repo "$TARGET_REPO" --body "Nightly run `$run_id` opened draft PR: $pr_url" >/dev/null 2>&1 || github_errors=$((github_errors + 1))
  gh_write issue edit "$num" --repo "$TARGET_REPO" --remove-label "$QUEUE_LABEL" --add-label "nightly:pr-open" >/dev/null 2>&1 || github_errors=$((github_errors + 1))

  implemented=$((implemented + 1))
  printf '#%s\t%s\t%s\n' "$num" "$title" "$pr_url" >> "$prs_file"
  log "draft PR opened: $pr_url"

  git checkout "$BASE_BRANCH"
  git branch -D "$branch_name" 2>/dev/null || true
}

set_phase "queue"

if [[ "$MODE" != "discover-only" ]]; then
  effective_max="$MAX_ISSUES_PER_NIGHT"
  [[ "$MODE" == "once" ]] && effective_max=1

  while before "$wrap_epoch" && (( implemented + blocked < effective_max )); do
    hard_guard

    issue_line="$(gh_read issue list       --repo "$TARGET_REPO"       --state open       --label "$QUEUE_LABEL"       --limit 50       --json number,title       --jq '.[] | [.number,.title] | @tsv'       | while IFS=$'\t' read -r n t; do
          grep -qx "$n" "$processed" || { printf '%s\t%s\n' "$n" "$t"; break; }
        done)"

    [[ -n "$issue_line" ]] || break
    IFS=$'\t' read -r issue_num issue_title <<<"$issue_line"
    echo "$issue_num" >> "$processed"
    publish_issue_work "$issue_num" "$issue_title"

    git checkout "$BASE_BRANCH" >/dev/null 2>&1 || true
    git reset --hard "origin/$BASE_BRANCH" >/dev/null 2>&1 || true
  done
fi

if [[ "$MODE" != "once" ]] && before "$discovery_epoch" && (( created_issues < MAX_DISCOVERY_ISSUES )); then
  hard_guard
  set_phase "discovery"
  log "starting bounded discovery"

  git checkout "$BASE_BRANCH"
  git reset --hard "origin/$BASE_BRANCH"
  mkdir -p .codex-automation
  printf '{"items":[]}\n' > .codex-automation/discoveries.json

  discovery_prompt="Inspect this repository for concrete bugs, test/quality gaps, and UX problems. Do not edit project files. Write at most $MAX_DISCOVERY_ISSUES evidence-based findings to .codex-automation/discoveries.json. The file must be valid JSON with this exact shape: {\"items\":[{\"type\":\"bug|quality|ux|idea\",\"title\":\"short title\",\"summary\":\"what is wrong or could improve\",\"evidence\":\"concrete file, behavior, or command evidence\",\"suggested_acceptance\":\"how a future agent can verify the fix\"}]}. Do not invent work. Avoid duplicates. Do not modify any other files."

  run_codex "$discovery_prompt" "discovery" || true
  if before "$hard_epoch"; then
    create_discovery_issues ".codex-automation/discoveries.json" "bounded discovery pass"
  fi
  rm -rf .codex-automation
fi

hard_guard
set_phase "wrap-up"
log "entering wrap-up"
git checkout "$BASE_BRANCH" >/dev/null 2>&1 || true

jq -n   --arg run_id "$run_id"   --arg repository "$TARGET_REPO"   --arg model "$MODEL"   --arg mode "$MODE"   --arg started "$(head -n 1 "$run_log" | sed -n 's/^\[\([^]]*\)\].*/\1/p')"   --arg finished "$(date --iso-8601=seconds)"   --arg hard_stop "$(date -d "@$hard_epoch" --iso-8601=seconds)"   --argjson implemented "$implemented"   --argjson blocked "$blocked"   --argjson discovered "$created_issues"   --argjson github_errors "$github_errors"   '{run_id:$run_id,repository:$repository,model:$model,mode:$mode,started_at:$started,finished_at:$finished,hard_stop:$hard_stop,implemented:$implemented,blocked:$blocked,discovery_issues_created:$discovered,github_errors:$github_errors}'   > "$summary"

{
  echo "# Nightly report - $night_date"
  echo
  echo "- Run ID: `$run_id`"
  echo "- Repository: `$TARGET_REPO`"
  echo "- Model: `$MODEL`"
  echo "- Mode: `$MODE`"
  echo "- Implemented / PR opened: $implemented"
  echo "- Blocked: $blocked"
  echo "- Discovery issues created: $created_issues"
  echo "- GitHub side-effect errors: $github_errors"
  echo "- Validation: `$VALIDATE_CMD`"
  echo "- Hard stop: $(date -d "@$hard_epoch" --iso-8601=seconds)"
  if [[ -n "$recovered_stash" ]]; then
    echo "- Recovered interrupted changes: `$recovered_stash`"
  fi
  echo
  echo "## Draft PRs"
  if [[ -s "$prs_file" ]]; then
    while IFS=$'\t' read -r num title url; do
      echo "- $num $title - $url"
    done < "$prs_file"
  else
    echo "- None"
  fi
  echo
  echo "## Blocked"
  if [[ -s "$blocked_file" ]]; then
    while IFS=$'\t' read -r num reason; do
      echo "- $num - $reason"
    done < "$blocked_file"
  else
    echo "- None"
  fi
  echo
  echo "## Discovered"
  if [[ -s "$discoveries_file" ]]; then
    while IFS=$'\t' read -r type title url; do
      echo "- [$type] $title - $url"
    done < "$discoveries_file"
  else
    echo "- None"
  fi
} > "$report"

set_phase "complete"
log "report=$report"
log "done implemented=$implemented blocked=$blocked discovered=$created_issues github_errors=$github_errors"
